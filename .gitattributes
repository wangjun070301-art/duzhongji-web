# These files are build output, byte for byte.
#
# This machine has core.autocrlf=true, which rewrites LF as CRLF on checkout.
# For the Dart bundle that only changes its size; for wasm, fonts, images and
# audio it corrupts the payload. Mark every binary type as binary and disable
# text conversion for the generated sources.

* -text

*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.svg  text eol=lf

*.wasm  binary
*.ttf   binary
*.otf   binary
*.woff2 binary
*.webp  binary
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.m4a   binary
*.mp3   binary
*.zip   binary
*.bin   binary
